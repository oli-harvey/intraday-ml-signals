# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Alpaca PAPER trading credentials (https://app.alpaca.markets/ -> Paper account)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper endpoints (do NOT point at live trading)
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex          # free equities feed; crypto uses its own stream

# Optional alternate data sources (Phase 1+ swap-in)
FINNHUB_API_KEY=
POLYGON_API_KEY=
