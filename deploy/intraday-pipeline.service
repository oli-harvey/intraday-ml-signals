# User-level systemd unit for the 24/7 crypto paper-trading pipeline.
# Install (as deploy): see deploy/setup_server.sh or docs/DEPLOY.md.
#   systemctl --user enable --now intraday-pipeline
# Requires: loginctl enable-linger deploy   (so it runs without an SSH session)

[Unit]
Description=intraday-ml-signals paper trading pipeline (crypto, 24/7)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/intraday-ml-signals
# hoeffding + Coinbase leader = the only config that beats all naive baselines
# (docs/RESEARCH.md 2026-07-08). The CB feed also lands in the cold store, so
# this service doubles as continuous dual-venue capture for replication.
# Six pairs, each with a same-asset Coinbase leader: the venue-gap signal
# should be strongest where Alpaca's venue is most stale (the sparse alts).
ExecStart=%h/intraday-ml-signals/.venv/bin/python -m signals.pipeline \
    --symbols BTC/USD ETH/USD SOL/USD DOGE/USD LTC/USD LINK/USD \
    --model hoeffding \
    --horizon-s 5 \
    --cb-leader BTC/USD ETH/USD SOL/USD DOGE/USD LTC/USD LINK/USD \
    --db data/paper_live.duckdb \
    --max-position-usd 500 \
    --max-open-positions 2 \
    --daily-loss-limit-usd 100
Restart=always
RestartSec=10
# Paper keys only on this box — .env is read from WorkingDirectory.

[Install]
WantedBy=default.target
